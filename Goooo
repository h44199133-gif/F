<script>

/* =========================================
   كلمة السر الجديدة
========================================= */

const CORRECT_CODE = "بشمهندس";


/* =========================================
   رسائل الاعتذار
========================================= */

const messages = [

`
أنا آسف بجد، ومش مجرد كلمة بقولها وخلاص.
<br>
عارف إني غلطت وعارف إن تصرفاتي ضايقتك،
<br>
ومهما حاولت أبرر، مفيش مبرر كفاية لللي حصل.
<br>
أنا مقدّر زعلك، وحقك عليّا من قلبي ❤️
`,

`
أنا آسف على كل لحظة خلتك تزعل بسببي.
<br>
يمكن كلمة "آسف" مش كفاية،
بس أنا فعلًا ندمان.
<br>
مش عايز أخسر حد غالي بسبب تصرف مني،
<br>
ووعد مني إني أحاول أكون أحسن. 🤍
`,

`
حقك عليّا يا بشمهندس...
<br>
أنا عارف إني كنت رخم وغلطت،
ومش ههرب من غلطي.
<br>
يمكن مقدرتش أوضحلك قد إيه أنت مهم عندي،
<br>
لكن الحقيقة إن زعلك فارق معايا جدًا.
<br>
أنا آسف من قلبي ❤️
`,

`
لو الاعتذار يقدر يرجع الوقت،
كنت رجعت كل لحظة ضايقتك فيها.
<br>
أنا مش هقول إني مكنتش أقصد،
أنا هقول الحقيقة:
<br>
أنا غلطت... وأنا آسف.
<br>
وأتمنى تديني فرصة أثبتلك إن الاعتذار ده مش مجرد كلام. 🥺❤️
`,

`
أنا عارف إن الكلام سهل،
وعارف إن كلمة آسف لوحدها مش هتمسح اللي حصل.
<br>
عشان كده أنا مش طالب منك تنسى،
<br>
أنا بس طالب منك تعرف إني ندمان فعلًا.
<br>
وحقك عليّا في كل حاجة زعلتك مني. ❤️‍🩹
`,

`
يمكن أنا معرفتش أتصرف صح،
ويمكن هزار أو تصرف مني وصلّك إحساس وحش.
<br>
لكن عمري ما كنت عايز أكون سبب في زعلك.
<br>
أنا آسف جدًا،
<br>
ومن قلبي بتمنى تسامحني. 🤍
`,

`
أعتذر لك عن كل كلمة قلتها وكان المفروض أسكت،
<br>
وعن كل موقف كان المفروض أتصرف فيه بطريقة أحسن.
<br>
أنا غلطت، وأنا معترف بغلطتي.
<br>
ومهما كان الاعتذار بسيط،
فهو خارج من قلبي فعلًا. ❤️
`,

`
أنت تستحق اعتذار أكبر من مجرد كلمة "آسف".
<br>
تستحق إني أعترف بغلطتي من غير مبررات،
<br>
وأحاول أصلح اللي حصل بدل ما أتكلم بس.
<br>
أنا آسف بجد،
<br>
وحقك عليّا. ❤️
`,

`
بعد كل المعادلات والحسابات الهندسية...
<br>
وصلنا للنتيجة النهائية:
<br><br>
<strong>
أنا غلطت + أنت زعلت = لازم أعتذر 😂❤️
</strong>
<br><br>
والحل الوحيد المقبول:
<br>
سامحني يا بشمهندس 🤍
`,

`
⚠ ENGINEERING ERROR DETECTED!
<br><br>
سبب الخطأ:
<br>
رخامة زيادة عن الحد المسموح به هندسيًا 😂
<br><br>
الحل:
<br>
اعتذار رسمي + ندم حقيقي + محاولة عدم تكرار الخطأ ❤️
<br><br>
STATUS: APOLOGY SENT ✓
`

];


let lastMessage = -1;


/* =========================================
   فحص كلمة السر
========================================= */

function checkCode(){

    const input =
        document.getElementById("passcode");

    const error =
        document.getElementById("error");

    if(input.value.trim() === CORRECT_CODE){

        error.style.display = "none";

        document.getElementById("login")
            .style.display = "none";

        document.getElementById("loading")
            .style.display = "block";

        startLoading();

    }else{

        error.style.display = "block";

        input.value = "";

        input.focus();

        const card =
            document.getElementById("card");

        card.animate(
            [
                {transform:"translateX(0)"},
                {transform:"translateX(-10px)"},
                {transform:"translateX(10px)"},
                {transform:"translateX(-6px)"},
                {transform:"translateX(0)"}
            ],
            {
                duration:350
            }
        );
    }
}


/* =========================================
   Loading
========================================= */

function startLoading(){

    let percent = 0;

    const bar =
        document.getElementById("loadingBar");

    const percentText =
        document.getElementById("loadingPercent");

    const loadText =
        document.getElementById("loadText");

    const texts = [

        "> Checking friendship data...",

        "> Searching for mistakes...",

        "> Calculating apology...",

        "> Installing forgiveness protocol...",

        "> Repairing friendship...",

        "> Finalizing system..."

    ];

    const interval =
        setInterval(() => {

            percent += 2;

            bar.style.width =
                percent + "%";

            percentText.textContent =
                percent + "%";

            const index =
                Math.min(
                    Math.floor(percent / 18),
                    texts.length - 1
                );

            loadText.textContent =
                texts[index];

            if(percent >= 100){

                clearInterval(interval);

                setTimeout(
                    startCountdown,
                    500
                );

            }

        },40);
}


/* =========================================
   Countdown
========================================= */

function startCountdown(){

    document.getElementById("loading")
        .style.display = "none";

    document.getElementById("countdown")
        .style.display = "block";

    let number = 3;

    const numberElement =
        document.getElementById("number");

    numberElement.textContent = number;

    const timer =
        setInterval(() => {

            number--;

            if(number > 0){

                numberElement.textContent =
                    number;

                numberElement.style.animation =
                    "none";

                void numberElement.offsetWidth;

                numberElement.style.animation =
                    "countAnimation 1s ease";

            }else{

                clearInterval(timer);

                openMessage();

            }

        },1000);
}


/* =========================================
   فتح الرسالة
========================================= */

function openMessage(){

    document.getElementById("countdown")
        .style.display = "none";

    const message =
        document.getElementById("secretMessage");

    message.style.display = "block";

    message.classList.remove("messageOpen");

    void message.offsetWidth;

    message.classList.add("messageOpen");

    showRandomMessage();

    createParticles();

}


/* =========================================
   رسالة عشوائية
========================================= */

function showRandomMessage(){

    let index;

    do{

        index =
            Math.floor(
                Math.random() * messages.length
            );

    }while(
        index === lastMessage &&
        messages.length > 1
    );

    lastMessage = index;

    const box =
        document.getElementById("messageText");

    const number =
        document.getElementById("messageNumber");

    box.style.opacity = "0";

    box.style.transform =
        "scale(.95)";

    setTimeout(() => {

        box.innerHTML =
            messages[index];

        number.textContent =
            "💌 APOLOGY MESSAGE " +
            (index + 1) +
            " / " +
            messages.length;

        box.style.opacity = "1";

        box.style.transform =
            "scale(1)";

    },250);

    createParticles();

}


/* =========================================
   Easter Egg
========================================= */

function showSecret(){

    const egg =
        document.getElementById("easterEgg");

    if(
        egg.style.display === "block"
    ){

        egg.style.display = "none";

    }else{

        egg.style.display = "block";

        createParticles();

    }

}


/* =========================================
   قلوب ونجوم
========================================= */

function createParticles(){

    const container =
        document.getElementById("particles");

    const symbols = [
        "❤️",
        "💕",
        "💖",
        "💙",
        "💜",
        "🤍",
        "⭐",
        "✨",
        "⚙️",
        "📐"
    ];

    for(let i = 0; i < 20; i++){

        const particle =
            document.createElement("div");

        particle.className =
            "particle";

        particle.textContent =
            symbols[
                Math.floor(
                    Math.random() *
                    symbols.length
                )
            ];

        particle.style.left =
            Math.random() * 100 + "%";

        particle.style.fontSize =
            (14 + Math.random() * 25) + "px";

        particle.style.animationDuration =
            (3 + Math.random() * 4) + "s";

        particle.style.animationDelay =
            Math.random() * 1.5 + "s";

        container.appendChild(particle);

        setTimeout(() => {

            particle.remove();

        },8000);

    }

}


