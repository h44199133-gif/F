<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Engineering Secret System</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    min-height:100vh;
    overflow:hidden;
    font-family:Tahoma,Arial,sans-serif;
    background:
        radial-gradient(circle at top,#172554,#020617 65%);
    color:#fff;
    display:flex;
    justify-content:center;
    align-items:center;
}

/* =========================
   الخلفية الهندسية
========================= */

.engineering-bg{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:0;
}

.grid{
    position:absolute;
    inset:0;
    background-image:
        linear-gradient(rgba(96,165,250,.08) 1px,transparent 1px),
        linear-gradient(90deg,rgba(96,165,250,.08) 1px,transparent 1px);
    background-size:35px 35px;
}

.tool{
    position:absolute;
    font-size:28px;
    opacity:.18;
    animation:toolFloat 12s linear infinite;
}

.tool:nth-child(2){left:5%;top:15%}
.tool:nth-child(3){left:85%;top:20%;animation-delay:2s}
.tool:nth-child(4){left:15%;top:75%;animation-delay:4s}
.tool:nth-child(5){left:75%;top:75%;animation-delay:1s}
.tool:nth-child(6){left:45%;top:10%;animation-delay:3s}
.tool:nth-child(7){left:55%;top:85%;animation-delay:5s}

@keyframes toolFloat{
    0%,100%{
        transform:rotate(0deg) translateY(0);
    }
    50%{
        transform:rotate(180deg) translateY(-20px);
    }
}

/* =========================
   القلوب والنجوم
========================= */

.particles{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:3;
}

.particle{
    position:absolute;
    bottom:-50px;
    animation:floatUp linear infinite;
    opacity:0;
}

@keyframes floatUp{
    0%{
        transform:translateY(0) rotate(0);
        opacity:0;
    }

    15%{
        opacity:.8;
    }

    100%{
        transform:translateY(-110vh) rotate(360deg);
        opacity:0;
    }
}

/* =========================
   الكارت
========================= */

.card{
    position:relative;
    z-index:10;

    width:min(94%,520px);
    max-height:90vh;
    overflow:auto;

    padding:30px 25px;

    border-radius:28px;

    background:rgba(15,23,42,.82);
    border:1px solid rgba(96,165,250,.3);

    backdrop-filter:blur(18px);

    box-shadow:
        0 25px 80px rgba(0,0,0,.55),
        0 0 50px rgba(59,130,246,.08);

    text-align:center;
}

.card::-webkit-scrollbar{
    width:4px;
}

.card::-webkit-scrollbar-thumb{
    background:#475569;
    border-radius:10px;
}

/* =========================
   الشعار
========================= */

.logo{
    font-size:52px;
    margin-bottom:10px;
}

.system-title{
    font-size:24px;
    font-weight:bold;
    margin-bottom:8px;
}

.system-subtitle{
    color:#94a3b8;
    font-size:13px;
    margin-bottom:25px;
}

/* =========================
   Terminal
========================= */

.terminal{
    text-align:left;
    direction:ltr;

    background:#020617;

    border:1px solid #1e3a8a;

    border-radius:15px;

    padding:16px;

    margin-bottom:22px;

    font-family:monospace;
    font-size:13px;

    color:#60a5fa;

    min-height:125px;
}

.terminal .green{
    color:#4ade80;
}

.terminal .yellow{
    color:#facc15;
}

/* =========================
   القفل
========================= */

.lock-icon{
    font-size:65px;
    margin-bottom:10px;

    animation:lockFloat 2s ease-in-out infinite;
}

@keyframes lockFloat{
    0%,100%{transform:translateY(0)}
    50%{transform:translateY(-8px)}
}

.subtitle{
    color:#cbd5e1;
    line-height:1.8;
    margin-bottom:20px;
}

/* =========================
   Input
========================= */

input{
    width:100%;

    padding:15px;

    border-radius:14px;
    border:1px solid #334155;
    outline:none;

    background:#020617;

    color:white;

    text-align:center;

    font-size:20px;

    margin-bottom:14px;
}

input:focus{
    border-color:#60a5fa;
    box-shadow:0 0 20px rgba(96,165,250,.2);
}

input::placeholder{
    color:#64748b;
}

/* =========================
   Buttons
========================= */

button{
    width:100%;

    padding:14px;

    border:none;
    border-radius:14px;

    background:
        linear-gradient(135deg,#2563eb,#7c3aed);

    color:white;

    font-size:17px;
    font-weight:bold;

    cursor:pointer;

    transition:.3s;

    margin-top:8px;
}

button:hover{
    transform:translateY(-2px);

    box-shadow:
        0 10px 30px rgba(59,130,246,.3);
}

button:active{
    transform:scale(.97);
}

/* =========================
   Error
========================= */

.error{
    display:none;

    color:#f87171;

    margin-top:14px;

    font-size:14px;
}

/* =========================
   Loading
========================= */

#loading{
    display:none;
}

.loading-title{
    font-size:22px;
    margin-bottom:20px;
}

.loading-box{
    width:100%;
    height:16px;

    background:#020617;

    border-radius:20px;

    overflow:hidden;

    border:1px solid #1e3a8a;
}

.loading-bar{
    width:0%;
    height:100%;

    background:
        linear-gradient(
            90deg,
            #2563eb,
            #8b5cf6,
            #ec4899
        );

    transition:.2s;
}

.loading-percent{
    margin-top:12px;
    color:#93c5fd;
}

/* =========================
   Countdown
========================= */

#countdown{
    display:none;
}

.count-text{
    color:#cbd5e1;
    line-height:1.8;
    margin-bottom:15px;
}

#number{
    font-size:100px;
    font-weight:bold;

    background:
        linear-gradient(
            135deg,
            #60a5fa,
            #c084fc,
            #f472b6
        );

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;

    animation:countAnimation 1s ease;
}

@keyframes countAnimation{
    0%{
        transform:scale(1.8);
        opacity:0;
    }

    100%{
        transform:scale(1);
        opacity:1;
    }
}

/* =========================
   الرسالة
========================= */

#secretMessage{
    display:none;
}

.messageOpen{
    animation:messageOpen .9s ease;
}

@keyframes messageOpen{
    0%{
        opacity:0;
        transform:scale(.5) translateY(40px);
    }

    70%{
        transform:scale(1.05) translateY(-5px);
    }

    100%{
        opacity:1;
        transform:scale(1);
    }
}

.envelope{
    font-size:65px;

    animation:
        envelopeOpen 1s ease,
        heartbeat 1.5s ease-in-out 1s infinite;
}

@keyframes envelopeOpen{
    from{
        transform:rotateY(180deg) scale(.5);
        opacity:0;
    }

    to{
        transform:rotateY(0) scale(1);
        opacity:1;
    }
}

@keyframes heartbeat{
    0%,100%{transform:scale(1)}
    50%{transform:scale(1.08)}
}

.message-title{
    font-size:26px;
    margin:12px 0 18px;

    background:
        linear-gradient(
            90deg,
            #93c5fd,
            #c4b5fd,
            #f9a8d4
        );

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;
}

.message-box{
    min-height:170px;

    padding:22px 17px;

    border-radius:20px;

    background:rgba(255,255,255,.06);

    border:1px solid rgba(255,255,255,.1);

    line-height:2;

    font-size:17px;

    display:flex;
    justify-content:center;
    align-items:center;

    transition:.5s;
}

.message-number{
    color:#64748b;
    font-size:13px;
    margin-top:12px;
}

/* =========================
   مستوى الاعتذار
========================= */

.apology-title{
    margin-top:20px;
    font-size:13px;
    color:#94a3b8;
}

.apology-bar{
    width:100%;
    height:10px;

    background:#020617;

    border-radius:20px;

    overflow:hidden;

    margin-top:8px;
}

.apology-fill{
    width:100%;
    height:100%;

    background:
        linear-gradient(
            90deg,
            #3b82f6,
            #8b5cf6,
            #ec4899
        );

    animation:apologyPulse 2s infinite;
}

@keyframes apologyPulse{
    50%{
        filter:brightness(1.5);
    }
}

/* =========================
   Easter Egg
========================= */

#easterEgg{
    display:none;

    margin-top:20px;

    padding:20px;

    border-radius:18px;

    background:
        rgba(34,197,94,.08);

    border:1px solid rgba(34,197,94,.3);

    line-height:2;
}

.easter-title{
    color:#4ade80;
    font-weight:bold;
    margin-bottom:8px;
}

/* =========================
   Footer
========================= */

.footer{
    margin-top:22px;

    color:#475569;

    font-size:11px;
}

.footer span{
    color:#64748b;
}

/* =========================
   Responsive
========================= */

@media(max-width:600px){

    .card{
        padding:25px 17px;
    }

    .system-title{
        font-size:21px;
    }

    .message-title{
        font-size:23px;
    }

    .message-box{
        font-size:16px;
    }

    #number{
        font-size:85px;
    }

}
</style>
</head>

<body>

<!-- =========================
     الخلفية
========================= -->

<div class="engineering-bg">

